{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-resolution-time.ps1\" -Event Stop",
            "statusMessage": "Tempo de Resolu\u00e7\u00e3o",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "statusMessage": "Registro de Execu\u00e7\u00e3o",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$msg = @{ systemMessage = 'graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.' }; if (Test-Path 'graphify-out/graph.json') { $msg | ConvertTo-Json -Compress }\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-resolution-time.ps1\" -Event SessionStart",
            "statusMessage": "Tempo de Resolu\u00e7\u00e3o",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
