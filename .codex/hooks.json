{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"if (Test-Path 'graphify-out/graph.json') { Write-Output '{`\"systemMessage`\":`\"Knowledge graphify exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.`\"}' }\"",
            "statusMessage": "Graphify Status",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/resolution-time/resolution-time.ps1\" -Event SessionStart",
            "statusMessage": "Resolution Time",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/self-improvement-observer/self-improvement-observer.ps1\" -Event SessionStart",
            "statusMessage": "Self Improvement Observer",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/resolution-time/resolution-time.ps1\" -Event Stop",
            "statusMessage": "Resolution Time",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/self-improvement-observer/self-improvement-observer.ps1\" -Event Stop",
            "statusMessage": "Self Improvement Observer",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/resolution-time/resolution-time.ps1\" -Event UserPromptSubmit",
            "statusMessage": "Resolution Time",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/scaffold-context-visibility.ps1\" -Event UserPromptSubmit",
            "statusMessage": "Scaffold Context Visibility",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/production-change-audit.ps1\" -Event UserPromptSubmit",
            "statusMessage": "Production Change Audit",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/self-improvement-observer/self-improvement-observer.ps1\" -Event UserPromptSubmit",
            "statusMessage": "Self Improvement Observer",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/self-improvement-observer/self-improvement-observer.ps1\" -Event PostToolUse",
            "statusMessage": "Self Improvement Observer",
            "timeout": 20
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
