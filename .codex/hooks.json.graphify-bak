{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v pwsh >/dev/null 2>&1; then ps=pwsh; elif [ -x \"$HOME/.local/bin/pwsh\" ]; then ps=\"$HOME/.local/bin/pwsh\"; else echo 'pwsh 7 is required for Codex hooks' >&2; exit 1; fi; \"$ps\" -NoLogo -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/.codex/hooks/git-freshness-preflight/git-freshness-preflight.ps1\" -Event SessionStart",
            "commandWindows": "$ps = (Get-Command pwsh.exe -ErrorAction SilentlyContinue).Source; if (-not $ps) { $ps = (Get-Command powershell.exe -ErrorAction Stop).Source }; & $ps -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/git-freshness-preflight/git-freshness-preflight.ps1\" -Event SessionStart",
            "statusMessage": "Git Freshness Preflight",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v pwsh >/dev/null 2>&1; then ps=pwsh; elif [ -x \"$HOME/.local/bin/pwsh\" ]; then ps=\"$HOME/.local/bin/pwsh\"; else echo 'pwsh 7 is required for Codex hooks' >&2; exit 1; fi; \"$ps\" -NoLogo -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/.codex/hooks/graphify-context.ps1\" -Event SessionStart",
            "commandWindows": "$ps = (Get-Command pwsh.exe -ErrorAction SilentlyContinue).Source; if (-not $ps) { $ps = (Get-Command powershell.exe -ErrorAction Stop).Source }; & $ps -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/graphify-context.ps1\" -Event SessionStart",
            "statusMessage": "Graphify Context",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v pwsh >/dev/null 2>&1; then ps=pwsh; elif [ -x \"$HOME/.local/bin/pwsh\" ]; then ps=\"$HOME/.local/bin/pwsh\"; else echo 'pwsh 7 is required for Codex hooks' >&2; exit 1; fi; \"$ps\" -NoLogo -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/.codex/hooks/resolution-time/resolution-time.ps1\" -Event SessionStart",
