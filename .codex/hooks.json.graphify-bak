    "PreToolUse": [
      {
        "matcher": "^(Bash|shell_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v pwsh >/dev/null 2>&1; then ps=pwsh; elif [ -x \"$HOME/.local/bin/pwsh\" ]; then ps=\"$HOME/.local/bin/pwsh\"; else echo 'pwsh 7 is required for Codex hooks' >&2; exit 1; fi; \"$ps\" -NoLogo -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/.codex/hooks/windows-shell-preflight.ps1\" -Event PreToolUse",
